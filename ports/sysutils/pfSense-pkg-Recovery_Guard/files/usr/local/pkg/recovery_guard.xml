<?xml version="1.0" encoding="UTF-8"?>
<packagegui>
  <name>Recovery Guard</name>
  <title>Services: Recovery Guard</title>
  <description>Independent recovery supervisor configuration</description>
  <donotsave>true</donotsave>
  <include_file>/usr/local/pkg/recovery_guard.inc</include_file>
  <menu>
    <name>Recovery Guard</name>
    <section>Services</section>
    <url>/services_recovery_guard.php</url>
  </menu>
  <service>
    <name>recovery_guard</name>
    <description>Recovery Guard monitor</description>
    <!-- rcfile is owned and unlinked by pfSense during service removal.
         This script belongs to pkg-plist; keep its ownership with pkg. -->
    <rcfile/>
    <startcmd>mwexec('/usr/local/etc/rc.d/recovery_guard.sh start');</startcmd>
    <stopcmd>mwexec('/usr/local/etc/rc.d/recovery_guard.sh stop');</stopcmd>
    <starts_on_sync/>
    <custom_php_service_status_command>is_pid_running('/var/run/recovery_guard.pid')</custom_php_service_status_command>
  </service>
  <custom_php_resync_config_command>recovery_guard_service_apply();</custom_php_resync_config_command>
  <custom_php_deinstall_command>recovery_guard_service_apply(true);</custom_php_deinstall_command>
</packagegui>
